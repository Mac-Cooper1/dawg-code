{"event":"tool.finished","payload":{"sessionId":"flaky-csv","seq":146,"time":1795338040063,"turnId":"turn-2","toolCallId":"call-90e4e613d927","toolName":"Read","outcome":"success","content":[{"type":"text","text":" 1→\"\"\"Read receipts exported as CSV.\"\"\"\n 2→\n 3→import csv\n 4→from concurrent.futures import ThreadPoolExecutor, as_completed\n 5→from dataclasses import dataclass\n 6→from decimal import Decimal, InvalidOperation\n 7→from pathlib import Path\n 8→\n 9→CHUNK_ROWS = 1_000\n10→WORKERS = 4\n11→\n12→\n13→@dataclass(frozen=True)\n14→class CsvRow:\n15→    line: int\n16→    description: str\n17→    amount: Decimal\n18→    currency: str\n19→    paid_by: str\n20→\n21→\n22→class ImportError_(ValueError):\n23→    def __init__(self, line: int, message: str):\n24→        super().__init__(f\"line {line}: {message}\")\n25→        self.line = line\n26→\n27→\n28→def _parse(line: int, record: dict[str, str]) -> CsvRow:\n29→    try:\n30→        amount = Decimal(record[\"amount\"])\n31→    except InvalidOperation:\n32→        raise ImportError_(line, f\"not an amount: {record['amount']!r}\") from None\n33→    return CsvRow(\n34→        line=line,\n35→        description=record[\"description\"].strip(),\n36→        amount=amount,\n37→        currency=record[\"currency\"].upper(),\n38→        paid_by=record[\"paid_by\"].strip(),\n39→    )\n40→\n41→\n42→def _parse_chunk(chunk: list[tuple[int, dict[str, str]]]) -> list[CsvRow]:\n43→    return [_parse(line, record) for line, record in chunk]\n44→\n45→\n46→def _chunks(path: Path):\n47→    with path.open(newline=\"\") as f:\n48→        reader = csv.DictReader(f)\n49→        chunk = []\n50→        for line, record in enumerate(reader, start=2):\n51→            if not any(record.values()):\n52→                continue\n53→            chunk.append((line, record))\n54→            if len(chunk) == CHUNK_ROWS:\n55→                yield chunk\n56→                chunk = []\n57→        if chunk:\n58→            yield chunk\n59→\n60→\n61→def import_csv(path: Path) -> list[CsvRow]:\n62→    \"\"\"Parse a receipts CSV, a chunk of rows per worker.\"\"\"\n63→    rows: list[CsvRow] = []\n64→    with ThreadPoolExecutor(max_workers=WORKERS) as executor:\n65→        futures = [executor.submit(_parse_chunk, c) for c in _chunks(path)]\n66→        for future in as_completed(futures):\n67→            rows.extend(future.result())\n68→    return rows\n69→\n70→\n71→def import_csv_rows(path: Path) -> int:\n72→    \"\"\"How many rows import_csv would return, without keeping them.\"\"\"\n73→    return sum(len(c) for c in _chunks(path))\n74→"}],"display":{"kind":"file","filePath":"~/code/tally/src/tally/csv_import.py","startLine":1,"lineCount":74,"totalLines":74,"truncated":false},"durationMs":6}}
