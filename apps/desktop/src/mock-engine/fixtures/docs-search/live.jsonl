{"event":"tool.started","payload":{"sessionId":"docs-search","seq":32,"time":1795338076297,"turnId":"turn-2","messageId":"message-d33c0747a077","toolCallId":"call-0423558fe971","toolName":"Write","input":{"file_path":"~/code/dawg-site/src/scripts/search-index.ts","content":"// Builds the search index at build time: one entry per heading, with its section's text.\nimport { getCollection } from \"astro:content\";\n\nexport interface SearchEntry {\n  title: string;\n  heading: string;\n  url: string;\n  text: string;\n}\n\nexport async function buildIndex(): Promise<SearchEntry[]> {\n  const docs = await getCollection(\"docs\");\n  return docs.flatMap((doc) => {\n    const sections = doc.body.split(/^## /m);\n    return sections.map((section, i) => {\n      const [first = \"\", ...rest] = section.split(\"\\n\");\n      const heading = i === 0 ? doc.data.title : first.trim();\n      const anchor = i === 0 ? \"\" : `#${heading.toLowerCase().replace(/[^a-z0-9]+/g, \"-\")}`;\n      return {\n        title: doc.data.title,\n        heading,\n        url: `/guide/${doc.id}${anchor}`,\n        text: rest.join(\" \").replace(/[#*`>_[\\]()]/g, \"\").slice(0, 600),\n      };\n    });\n  });\n}\n"}}}
