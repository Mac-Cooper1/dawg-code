{
  "name": "dawg-code",
  "version": "0.0.0",
  "private": true,
  "description": "A Mac desktop coding agent that runs local models.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fetch-runtime": "node scripts/fetch-runtime.ts",
    "fetch-ripgrep": "node scripts/fetch-ripgrep.ts",
    "dawg": "node packages/cli/src/main.ts",
    "eval": "node evals/runner/src/cli.ts",
    "eval:validate": "node evals/runner/src/cli.ts validate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
