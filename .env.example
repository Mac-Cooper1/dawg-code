# Copy to .env (git-ignored) and fill in. Never commit real keys.

# An OpenAI-compatible endpoint serving the development model.
DAWG_DEV_ENDPOINT_URL=https://example.invalid/v1
DAWG_DEV_API_KEY=
DAWG_DEV_MODEL=

# Optional: use a llama-server binary other than the pinned one.
# DAWG_RUNTIME_BIN=/path/to/llama-server
